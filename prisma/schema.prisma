generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AppRole {
  BUYER
  SELLER
  MIDMAN
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum MidmanVerificationStatus {
  PENDING
  VERIFIED
  SUSPENDED
  REVOKED
}

enum MidmanAvailability {
  AVAILABLE
  BUSY
  OFFLINE
}

enum ListingStatus {
  DRAFT
  ACTIVE
  RESERVED
  SOLD
  PAUSED
  REMOVED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum ConversationType {
  DIRECT
  TRANSACTION
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  SUPERSEDED
  EXPIRED
}

enum TransactionStatus {
  MIDMAN_ASSIGNED
  QUEUED
  TERMS_PENDING
  PAYMENT_PENDING
  PAYMENT_SUBMITTED
  PAYMENT_VERIFIED
  FULFILLMENT_PENDING
  COMPLETED
  CANCELLED
  DISPUTED
}

enum QueueStatus {
  WAITING
  IN_PROGRESS
  COMPLETED
  REMOVED
}

enum PaymentStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_COMPLETED
  RESOLVED_CANCELLED
}

enum ReportStatus {
  OPEN
  REVIEWED
  DISMISSED
}

enum ReportTargetType {
  LISTING
  USER
  REVIEW
}

model User {
  id        String   @id @db.Uuid
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  roles             UserRole[]
  profile           UserProfile?
  midmanProfile     MidmanProfile?
  listings          Listing[]
  conversations     ConversationMember[]
  messages          Message[]
  messageReads      MessageRead[]
  buyerProposals    TransactionProposal[] @relation("BuyerProposals")
  sellerProposals   TransactionProposal[] @relation("SellerProposals")
  proposedProposals TransactionProposal[] @relation("ProposedByUser")
  buyerTransactions Transaction[]         @relation("BuyerTransactions")
  sellerTransactions Transaction[]        @relation("SellerTransactions")
  agreements        TransactionAgreement[]
  payments           Payment[]
  verifications      PaymentVerification[]
  txEvents           TransactionEvent[]
  reviewsGiven       Review[]
  disputesOpened     Dispute[]
  disputeEvidence    DisputeEvidence[]
  disputeResolutions DisputeResolution[]
  reports            Report[]
  notifications      Notification[]
  auditLogs          AuditLog[]

  @@map("users")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      AppRole
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId])
  @@map("user_roles")
}

model UserProfile {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @unique @map("user_id") @db.Uuid
  username    String        @unique
  displayName String        @map("display_name")
  avatarUrl   String?       @map("avatar_url")
  bio         String?
  status      AccountStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model MidmanProfile {
  id                 String                   @id @default(uuid()) @db.Uuid
  userId             String                   @unique @map("user_id") @db.Uuid
  displayName        String                   @map("display_name")
  bio                String?
  verificationStatus MidmanVerificationStatus @default(PENDING) @map("verification_status")
  feeDescription     String                   @map("fee_description")
  availabilityStatus MidmanAvailability       @default(AVAILABLE) @map("availability_status")
  completedCount     Int                      @default(0) @map("completed_count")
  ratingAverage      Decimal                  @default(0) @map("rating_average") @db.Decimal(3, 2)
  verifiedAt         DateTime?                @map("verified_at") @db.Timestamptz
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime                 @updatedAt @map("updated_at") @db.Timestamptz

  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  socials        MidmanSocial[]
  paymentMethods MidmanPaymentMethod[]
  proposals      TransactionProposal[]
  transactions   Transaction[]
  queueItems     TransactionQueue[]
  reviews        Review[]

  @@index([verificationStatus, availabilityStatus])
  @@map("midman_profiles")
}

model MidmanSocial {
  id              String @id @default(uuid()) @db.Uuid
  midmanProfileId String @map("midman_profile_id") @db.Uuid
  platform        String
  url             String
  handle          String?

  midmanProfile MidmanProfile @relation(fields: [midmanProfileId], references: [id], onDelete: Cascade)

  @@index([midmanProfileId])
  @@map("midman_socials")
}

model MidmanPaymentMethod {
  id                  String  @id @default(uuid()) @db.Uuid
  midmanProfileId     String  @map("midman_profile_id") @db.Uuid
  methodName          String  @map("method_name")
  accountName         String  @map("account_name")
  accountNumberMasked String  @map("account_number_masked")
  isActive            Boolean @default(true) @map("is_active")

  midmanProfile MidmanProfile @relation(fields: [midmanProfileId], references: [id], onDelete: Cascade)

  @@index([midmanProfileId])
  @@map("midman_payment_methods")
}

model ListingCategory {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  listings Listing[]

  @@map("listing_categories")
}

model Listing {
  id               String        @id @default(uuid()) @db.Uuid
  sellerId         String        @map("seller_id") @db.Uuid
  categoryId       String        @map("category_id") @db.Uuid
  title            String
  description      String
  priceCentavos    Int           @map("price_centavos")
  status           ListingStatus @default(ACTIVE)
  skinsCount       Int?          @map("skins_count")
  collectorLevel   String?       @map("collector_level")
  highestRank      String?       @map("highest_rank")
  midmanPreference String?       @map("midman_preference")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  seller       User                  @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category     ListingCategory       @relation(fields: [categoryId], references: [id])
  media        ListingMedia[]
  chats        Conversation[]
  proposals    TransactionProposal[]
  transactions Transaction[]

  @@index([status, createdAt(sort: Desc)])
  @@index([sellerId])
  @@index([categoryId])
  @@map("listings")
}

model ListingMedia {
  id            String    @id @default(uuid()) @db.Uuid
  listingId     String    @map("listing_id") @db.Uuid
  mediaType     MediaType @map("media_type")
  storagePath   String    @map("storage_path")
  publicUrl     String    @map("public_url")
  mimeType      String    @map("mime_type")
  fileSizeBytes Int       @map("file_size_bytes")
  sortOrder     Int       @default(0) @map("sort_order")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, sortOrder])
  @@map("listing_media")
}

model Conversation {
  id        String           @id @default(uuid()) @db.Uuid
  type      ConversationType @default(DIRECT)
  listingId String?          @map("listing_id") @db.Uuid
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  listing     Listing?              @relation(fields: [listingId], references: [id], onDelete: SetNull)
  members     ConversationMember[]
  messages    Message[]
  proposals   TransactionProposal[]
  transaction Transaction?

  @@index([listingId])
  @@index([updatedAt(sort: Desc)])
  @@map("conversations")
}

model ConversationMember {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  joinedAt       DateTime  @default(now()) @map("joined_at") @db.Timestamptz
  lastReadAt     DateTime? @map("last_read_at") @db.Timestamptz

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

model Message {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  senderId       String   @map("sender_id") @db.Uuid
  body           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User                @relation(fields: [senderId], references: [id], onDelete: Cascade)
  attachments  MessageAttachment[]
  reads        MessageRead[]

  @@index([conversationId, createdAt(sort: Asc)])
  @@map("messages")
}

model MessageAttachment {
  id            String   @id @default(uuid()) @db.Uuid
  messageId     String   @map("message_id") @db.Uuid
  storagePath   String   @map("storage_path")
  publicUrl     String   @map("public_url")
  mimeType      String   @map("mime_type")
  fileSizeBytes Int      @map("file_size_bytes")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("message_attachments")
}

model MessageRead {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  readAt    DateTime @default(now()) @map("read_at") @db.Timestamptz

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
  @@map("message_reads")
}

model TransactionProposal {
  id               String         @id @default(uuid()) @db.Uuid
  conversationId   String         @map("conversation_id") @db.Uuid
  listingId        String         @map("listing_id") @db.Uuid
  buyerId          String         @map("buyer_id") @db.Uuid
  sellerId         String         @map("seller_id") @db.Uuid
  proposedById     String         @map("proposed_by_id") @db.Uuid
  midmanProfileId  String         @map("midman_profile_id") @db.Uuid
  status           ProposalStatus @default(PENDING)
  buyerAcceptedAt  DateTime?      @map("buyer_accepted_at") @db.Timestamptz
  sellerAcceptedAt DateTime?      @map("seller_accepted_at") @db.Timestamptz
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  conversation  Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  listing       Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer         User          @relation("BuyerProposals", fields: [buyerId], references: [id], onDelete: Cascade)
  seller        User          @relation("SellerProposals", fields: [sellerId], references: [id], onDelete: Cascade)
  proposedBy    User          @relation("ProposedByUser", fields: [proposedById], references: [id], onDelete: Cascade)
  midmanProfile MidmanProfile @relation(fields: [midmanProfileId], references: [id])
  transaction   Transaction?

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([listingId, status])
  @@map("transaction_proposals")
}

model Transaction {
  id                  String            @id @default(uuid()) @db.Uuid
  listingId           String            @map("listing_id") @db.Uuid
  proposalId          String            @unique @map("proposal_id") @db.Uuid
  conversationId      String            @unique @map("conversation_id") @db.Uuid
  buyerId             String            @map("buyer_id") @db.Uuid
  sellerId            String            @map("seller_id") @db.Uuid
  midmanProfileId     String            @map("midman_profile_id") @db.Uuid
  status              TransactionStatus @default(MIDMAN_ASSIGNED)
  agreedAmountCentavos Int?             @map("agreed_amount_centavos")
  midmanFeeCentavos   Int?              @map("midman_fee_centavos")
  termsNotes          String?           @map("terms_notes")
  fulfillmentNotes    String?           @map("fulfillment_notes")
  buyerConfirmedAt    DateTime?         @map("buyer_confirmed_at") @db.Timestamptz
  completedAt         DateTime?         @map("completed_at") @db.Timestamptz
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  listing       Listing                @relation(fields: [listingId], references: [id])
  proposal      TransactionProposal    @relation(fields: [proposalId], references: [id])
  conversation  Conversation           @relation(fields: [conversationId], references: [id])
  buyer         User                   @relation("BuyerTransactions", fields: [buyerId], references: [id])
  seller        User                   @relation("SellerTransactions", fields: [sellerId], references: [id])
  midmanProfile MidmanProfile          @relation(fields: [midmanProfileId], references: [id])
  agreements    TransactionAgreement[]
  queueEntry    TransactionQueue?
  events        TransactionEvent[]
  payments      Payment[]
  review        Review?
  dispute       Dispute?

  @@index([buyerId])
  @@index([sellerId])
  @@index([midmanProfileId, status])
  @@map("transactions")
}

model TransactionAgreement {
  id            String   @id @default(uuid()) @db.Uuid
  transactionId String   @map("transaction_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  approvedAt    DateTime @default(now()) @map("approved_at") @db.Timestamptz

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([transactionId, userId])
  @@map("transaction_agreements")
}

model TransactionQueue {
  id              String      @id @default(uuid()) @db.Uuid
  transactionId   String      @unique @map("transaction_id") @db.Uuid
  midmanProfileId String      @map("midman_profile_id") @db.Uuid
  position        Int
  status          QueueStatus @default(WAITING)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  transaction   Transaction   @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  midmanProfile MidmanProfile @relation(fields: [midmanProfileId], references: [id])

  @@index([midmanProfileId, status, position])
  @@map("transaction_queue")
}

model TransactionEvent {
  id            String   @id @default(uuid()) @db.Uuid
  transactionId String   @map("transaction_id") @db.Uuid
  actorId       String?  @map("actor_id") @db.Uuid
  eventType     String   @map("event_type")
  summary       String
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  actor       User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([transactionId, createdAt(sort: Desc)])
  @@map("transaction_events")
}

model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  transactionId   String        @map("transaction_id") @db.Uuid
  payerId         String        @map("payer_id") @db.Uuid
  amountCentavos  Int           @map("amount_centavos")
  status          PaymentStatus @default(SUBMITTED)
  referenceNumber String?       @map("reference_number")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  transaction   Transaction           @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  payer         User                  @relation(fields: [payerId], references: [id])
  receipts      PaymentReceipt[]
  verifications PaymentVerification[]

  @@index([transactionId, createdAt(sort: Desc)])
  @@map("payments")
}

model PaymentReceipt {
  id            String   @id @default(uuid()) @db.Uuid
  paymentId     String   @map("payment_id") @db.Uuid
  storagePath   String   @map("storage_path")
  mimeType      String   @map("mime_type")
  fileSizeBytes Int      @map("file_size_bytes")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("payment_receipts")
}

model PaymentVerification {
  id           String        @id @default(uuid()) @db.Uuid
  paymentId    String        @map("payment_id") @db.Uuid
  midmanUserId String        @map("midman_user_id") @db.Uuid
  decision     PaymentStatus
  notes        String?
  verifiedAt   DateTime      @default(now()) @map("verified_at") @db.Timestamptz

  payment    Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  midmanUser User    @relation(fields: [midmanUserId], references: [id])

  @@index([paymentId])
  @@map("payment_verifications")
}

model Review {
  id              String   @id @default(uuid()) @db.Uuid
  transactionId   String   @unique @map("transaction_id") @db.Uuid
  reviewerId      String   @map("reviewer_id") @db.Uuid
  midmanProfileId String   @map("midman_profile_id") @db.Uuid
  rating          Int
  comment         String
  vouchSlug       String   @unique @map("vouch_slug")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  transaction   Transaction   @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  reviewer      User          @relation(fields: [reviewerId], references: [id])
  midmanProfile MidmanProfile @relation(fields: [midmanProfileId], references: [id])

  @@index([midmanProfileId, createdAt(sort: Desc)])
  @@map("reviews")
}

model Dispute {
  id            String        @id @default(uuid()) @db.Uuid
  transactionId String        @unique @map("transaction_id") @db.Uuid
  openedById    String        @map("opened_by_id") @db.Uuid
  reason        String
  status        DisputeStatus @default(OPEN)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  transaction Transaction        @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  openedBy    User               @relation(fields: [openedById], references: [id])
  evidence    DisputeEvidence[]
  resolution  DisputeResolution?

  @@index([status, createdAt(sort: Desc)])
  @@map("disputes")
}

model DisputeEvidence {
  id            String   @id @default(uuid()) @db.Uuid
  disputeId     String   @map("dispute_id") @db.Uuid
  uploadedById  String   @map("uploaded_by_id") @db.Uuid
  storagePath   String   @map("storage_path")
  mimeType      String   @map("mime_type")
  fileSizeBytes Int      @map("file_size_bytes")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  dispute    Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation(fields: [uploadedById], references: [id])

  @@index([disputeId])
  @@map("dispute_evidence")
}

model DisputeResolution {
  id          String            @id @default(uuid()) @db.Uuid
  disputeId   String            @unique @map("dispute_id") @db.Uuid
  adminUserId String            @map("admin_user_id") @db.Uuid
  outcome     TransactionStatus
  notes       String
  resolvedAt  DateTime          @default(now()) @map("resolved_at") @db.Timestamptz

  dispute   Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  adminUser User    @relation(fields: [adminUserId], references: [id])

  @@map("dispute_resolutions")
}

model Report {
  id         String           @id @default(uuid()) @db.Uuid
  reporterId String           @map("reporter_id") @db.Uuid
  targetType ReportTargetType @map("target_type")
  targetId   String           @map("target_id") @db.Uuid
  reason     String
  status     ReportStatus     @default(OPEN)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  reporter User @relation(fields: [reporterId], references: [id])

  @@index([status, createdAt(sort: Desc)])
  @@map("reports")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String
  body      String
  linkUrl   String?  @map("link_url")
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt(sort: Desc)])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  action     String
  targetType String   @map("target_type")
  targetId   String   @map("target_id") @db.Uuid
  metadata   String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  actor User @relation(fields: [actorId], references: [id])

  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}
